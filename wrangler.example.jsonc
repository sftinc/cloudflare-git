{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cloudflare-git",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./public" },
  "observability": { "enabled": true },
  // Local dev. D1 runs locally; Artifacts is always remote (no simulator).
  "d1_databases": [
    { "binding": "DB", "database_name": "cloudflare-git-dev", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ],
  "artifacts": [{ "binding": "ARTIFACTS", "namespace": "cloudflare-git-dev", "remote": true }],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "dev.cloudflareaccess.com",
    "ACCESS_AUD": "dev-aud",
    "SITE_ORIGIN": "http://localhost:8787"
  },
  "env": {
    "production": {
      "name": "cloudflare-git",
      // Fill in during deployment (see README). Copy this file to wrangler.jsonc first; wrangler.jsonc is gitignored.
      "routes": [{ "pattern": "git.example.com", "custom_domain": true }],
      "workers_dev": false,
      "preview_urls": false,
      // Hourly: deletes the storage of repos deleted more than RESTORE_DAYS days + 24 hours ago (see README).
      "triggers": { "crons": ["0 * * * *"] },
      "d1_databases": [
        { "binding": "DB", "database_name": "cloudflare-git", "database_id": "REPLACE_WITH_D1_ID", "migrations_dir": "migrations" }
      ],
      "artifacts": [{ "binding": "ARTIFACTS", "namespace": "cloudflare-git" }],
      "vars": {
        "ACCESS_TEAM_DOMAIN": "REPLACE_ME.cloudflareaccess.com",
        "ACCESS_AUD": "REPLACE_ME",
        "SITE_ORIGIN": "https://git.example.com"
        // Optional; leave out for the defaults (see README).
        // "SITE_TITLE": "Cloudflare Git",
        // "RESTORE_DAYS": "30",
        // "LOGO_URL": "https://example.com/logo.svg",
        // "COMPANY_NAME": "Example Co."
      }
    }
  }
}
